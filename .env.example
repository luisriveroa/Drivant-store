# QuantumVault API Key — NEVER commit the real key
QUANTUMVAULT_API_KEY=qv_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Base URL for the QuantumVault API
QUANTUMVAULT_BASE_URL=https://www.quantumvault.me/api/v1

# REQUIRED: password for /admin and the purchase/balance/orders APIs (user: admin). Empty = blocked.
ADMIN_PASSWORD=

# Optional: Store name displayed in the UI
NEXT_PUBLIC_STORE_NAME=Drivant Store

# Optional: Store currency symbol
NEXT_PUBLIC_CURRENCY=USD

# Optional: override the order channels set in src/app/cart/page.tsx. Changing them needs a redeploy.
# WhatsApp number in international format, digits only (e.g. 591XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Telegram username without @
NEXT_PUBLIC_TELEGRAM_USERNAME=

# Optional: Telegram bot that notifies you of each new order
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional second supplier: TOD Gifts Store. Empty = not used.
TOD_API_KEY=
TOD_BASE_URL=https://api-maker-pal-production.up.railway.app

# Optional third supplier: Addyocart. Empty = not used.
ADDYO_API_KEY=
ADDYO_BASE_URL=https://addyocart.com/api/v1/index.php?vendor_id=60
